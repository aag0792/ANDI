# Copia este archivo como C:\ANDI\.env y rellénalo. NUNCA lo subas a GitHub.
SQL_SERVER=localhost
SQL_DATABASE=NOMBRE_DE_TU_BASE_SOFTLAND
SQL_USER=andi_gateway
SQL_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA_LOCAL
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_TOKEN=PEGA_AQUI_UN_TOKEN_LARGO

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
LOG_DIR=C:\ANDI\logs

# Acceso remoto: configura el origen público también en modo token.
# PUBLIC_BASE_URL=https://andi.and.cr

# OAuth Microsoft (al activar entra, GATEWAY_TOKEN deja de funcionar).
# GATEWAY_AUTH_MODE=entra
# ENTRA_TENANT_ID=UUID_DEL_TENANT
# ENTRA_CLIENT_ID=UUID_DE_LA_APLICACION_API
# ENTRA_ALLOWED_USER_IDS=UUID_DE_TU_USUARIO
# ENTRA_ALLOWED_CLIENT_IDS=UUID_DEL_CLIENTE_OAUTH
# ENTRA_ALLOWED_CLIENT_IDS es obligatorio: usa el registro cliente ANDI ChatGPT.
